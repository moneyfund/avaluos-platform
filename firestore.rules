rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.email == 'norvingarcia220@gmail.com';
    }

    function membershipPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function tenantPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function invitePath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/invites/$(request.auth.token.email);
    }

    function isActiveMember(tenantId) {
      return signedIn()
        && exists(membershipPath(tenantId))
        && get(membershipPath(tenantId)).data.status == 'active';
    }

    function hasTenantRole(tenantId, roles) {
      return isActiveMember(tenantId)
        && get(membershipPath(tenantId)).data.role in roles;
    }

    function hasEmailInvite(tenantId) {
      return signedIn()
        && request.auth.token.email != null
        && exists(invitePath(tenantId))
        && get(invitePath(tenantId)).data.status == 'active'
        && get(invitePath(tenantId)).data.email == request.auth.token.email;
    }

    function isPrimaryTenantEmail(tenantId) {
      return signedIn()
        && request.auth.token.email != null
        && exists(tenantPath(tenantId))
        && get(tenantPath(tenantId)).data.email == request.auth.token.email;
    }

    match /users/{uid} {
      allow read: if isPlatformAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isPlatformAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if false;
    }

    match /userTenants/{uid} {
      allow read: if isPlatformAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isPlatformAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid);
      allow delete: if isPlatformAdmin();
    }

    match /tenantDomains/{hostname} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isPlatformAdmin()
        || isActiveMember(tenantId)
        || (signedIn()
          && request.auth.token.email != null
          && resource.data.email == request.auth.token.email);

      allow create: if isPlatformAdmin()
        && request.resource.data.slug == tenantId
        && request.resource.data.status in ['active', 'suspended', 'expired'];

      allow update: if isPlatformAdmin() || hasTenantRole(tenantId, ['owner', 'admin']);
      allow delete: if isPlatformAdmin();

      match /invites/{email} {
        allow read: if isPlatformAdmin()
          || hasTenantRole(tenantId, ['owner', 'admin'])
          || (signedIn() && request.auth.token.email == email);

        allow create, update: if isPlatformAdmin()
          || hasTenantRole(tenantId, ['owner', 'admin']);

        allow delete: if isPlatformAdmin()
          || hasTenantRole(tenantId, ['owner', 'admin'])
          || (signedIn() && request.auth.token.email == email);
      }

      match /members/{uid} {
        allow read: if isPlatformAdmin()
          || (signedIn() && request.auth.uid == uid)
          || hasTenantRole(tenantId, ['owner', 'admin']);

        allow create: if isPlatformAdmin()
          || hasTenantRole(tenantId, ['owner', 'admin'])
          || (signedIn()
            && request.auth.uid == uid
            && request.auth.token.email != null
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.status == 'active'
            && (
              (hasEmailInvite(tenantId)
                && request.resource.data.role == get(invitePath(tenantId)).data.role)
              || (isPrimaryTenantEmail(tenantId)
                && request.resource.data.role == 'owner')
            ));

        allow update, delete: if isPlatformAdmin()
          || hasTenantRole(tenantId, ['owner', 'admin']);
      }
    }

    match /avaluos/{avaluoId} {
      allow read: if isPlatformAdmin() || isActiveMember(resource.data.tenantId);

      allow create: if hasTenantRole(
        request.resource.data.tenantId,
        ['owner', 'admin', 'valuer', 'agent']
      )
      && request.resource.data.createdBy == request.auth.uid;

      allow update: if isPlatformAdmin()
        || (hasTenantRole(
          resource.data.tenantId,
          ['owner', 'admin', 'valuer', 'agent']
        )
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.createdBy == resource.data.createdBy);

      allow delete: if isPlatformAdmin()
        || hasTenantRole(resource.data.tenantId, ['owner', 'admin']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
