rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'norvingarcia220@gmail.com';
    }

    function membershipPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function isActiveMember(tenantId) {
      return signedIn()
        && exists(membershipPath(tenantId))
        && get(membershipPath(tenantId)).data.status == 'active';
    }

    function hasTenantRole(tenantId, roles) {
      return isActiveMember(tenantId)
        && get(membershipPath(tenantId)).data.role in roles;
    }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /tenantDomains/{hostname} {
      allow read: if true;
      allow write: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isActiveMember(tenantId);
      allow create: if tenantId == 'norvin'
        && isBootstrapOwner()
        && request.resource.data.slug == 'norvin'
        && request.resource.data.status == 'active';
      allow update: if hasTenantRole(tenantId, ['owner', 'admin'])
        || (tenantId == 'norvin' && isBootstrapOwner());
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || hasTenantRole(tenantId, ['owner', 'admin']));
        allow create: if hasTenantRole(tenantId, ['owner', 'admin'])
          || (tenantId == 'norvin'
            && uid == request.auth.uid
            && isBootstrapOwner()
            && request.resource.data.role == 'owner'
            && request.resource.data.status == 'active');
        allow update, delete: if hasTenantRole(tenantId, ['owner', 'admin']);
      }
    }

    match /avaluos/{avaluoId} {
      allow read: if isActiveMember(resource.data.tenantId);

      allow create: if hasTenantRole(request.resource.data.tenantId, ['owner', 'admin', 'valuer', 'agent'])
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if hasTenantRole(resource.data.tenantId, ['owner', 'admin', 'valuer', 'agent'])
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if hasTenantRole(resource.data.tenantId, ['owner', 'admin']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
